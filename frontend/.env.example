# Copier ce fichier en .env.local et l'adapter (jamais commité).

# URL de l'API vue par le navigateur. Par défaut "/api" : en développement, Vite redirige
# vers BACKEND_URL ; en production, le serveur web (nginx…) sert l'API sur le même domaine.
# Pour une API sur un autre domaine : VITE_API_URL=https://api.diagnostic.sante.td/api
# (ce domaine-là doit alors autoriser l'origine du site dans CORS_ORIGINES côté backend).
VITE_API_URL=/api

# Adresse du backend pour le proxy de développement (npm run dev uniquement).
BACKEND_URL=http://localhost:3000
