# Copier ce fichier en .env et l'adapter (le fichier .env n'est jamais commité).
# Chargé automatiquement par npm start / npm run dev / npm run seed.

NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/diagnostic-centres-db

# Secret de signature des jetons : OBLIGATOIRE en production (longue chaîne aléatoire).
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION=15m
REFRESH_EXPIRATION_JOURS=30

# Origines web autorisées (CORS), séparées par des virgules. Vide = localhost:5173 hors production.
CORS_ORIGINES=

# Derrière un reverse proxy (nginx…) : nombre de proxys, pour que l'IP réelle soit utilisée.
TRUST_PROXY=

# Limitation de débit (facultatif)
RATE_LIMIT_CONNEXION=10
RATE_LIMIT_AUTH=100
RATE_LIMIT_API=300
